# ---- Postgres ----
POSTGRES_USER=tmg
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=chroniclex
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tmg:change_me_postgres@localhost:5433/chroniclex?schema=public

# ---- Redis / BullMQ ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_32chars_min!!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=chroniclex-archive
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_32chars_min!!
MINIO_REGION=us-east-1

# ---- API ----
NODE_ENV=development
API_PORT=3001
APP_VERSION=0.1.0

# ---- Auth (RS256 — no HMAC secrets) ----
JWT_PRIVATE_KEY_PATH=./apps/api/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./apps/api/keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=ar
