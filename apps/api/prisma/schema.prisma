// TMG Archive — domain schema (Phase 2)
// Rules: data integrity > auditability > performance. No hard deletes on entries.
// Uniqueness is enforced at the DB level, not just app-level.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  GROUP
  COMPANY
  PROJECT
}

enum Action {
  CREATE
  UPDATE
  DELETE
  RESTORE
  VIEW
  EXPORT
}

enum Resource {
  ENTRY
  PROJECT
  COMPANY
  USER
  AUDIT
  AUTH
}

model Company {
  id        String    @id @default(cuid())
  code      Int       @unique
  nameAr    String
  nameEn    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  projects  Project[]
  entries   Entry[]
}

model Project {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code      String
  nameAr    String
  nameEn    String
  deletedAt DateTime?
  entries   Entry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

// TODO(schema-review): per TMG domain rules, serials come from a single
// SAP instance shared across all companies. The correct constraint is
// likely @@unique([year, serial]) — global per year — NOT
// @@unique([companyId, year, serial]) as currently modeled.
// Confirmation pending Dr. Tarek. If confirmed, migration requires:
//   1. Schema change + new migration
//   2. entries.service.list: preview + create uniqueness checks scoped
//      to (year, serial) instead of (companyId, year, serial)
//   3. Frontend error messaging updated to say "already used this year"
//      rather than "already used in this company"
//   4. Backfill validation against existing data
model Entry {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  year       Int
  serial     String    @db.VarChar(10)
  typePrefix String    @db.VarChar(2)
  counter    Int
  fileKey    String    @unique
  fileName   String
  fileSize   Int
  mimeType   String    @default("application/pdf")
  fileHash   String
  uploadedBy String
  uploader   User      @relation("UploadedEntries", fields: [uploadedBy], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([companyId, year, serial])
  @@index([companyId, projectId, year])
  @@index([serial])
  @@index([typePrefix, year])
  @@index([fileHash])
  @@index([uploadedBy])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  nameAr       String
  nameEn       String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  uploads      Entry[]    @relation("UploadedEntries")
  auditLogs    AuditLog[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  action    Action
  resource  Resource
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([action, resource])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType ScopeType
  // GROUP-scoped grants carry scopeId = "" (empty-string sentinel).
  // scopeId is intentionally NOT nullable: Prisma forbids optional fields in
  // @@id, and Postgres PRIMARY KEYs reject NULLs — nullable would void the
  // uniqueness guarantee exactly for the most privileged (GROUP) scope.
  scopeId   String    @default("")

  @@id([userId, roleId, scopeType, scopeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     Action
  resource   Resource
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resource, resourceId])
}

// Key/value settings that admins may change at runtime (no redeploy).
// The only key today is `entry-prefixes` (allowed type prefixes for
// uploaded serials); missing rows fall back to code defaults.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
